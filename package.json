{
  "name": "isms-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "isms-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && cp -R dist/src/. dist/",
