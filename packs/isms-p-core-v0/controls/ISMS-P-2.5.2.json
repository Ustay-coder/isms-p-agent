  "control_id": "ISMS-P-2.5.2",
  "title": "사용자 식별",
  "domain": "보호대책 요구사항",
  "category": "인증 및 권한관리",
  "requirement": "Users must be uniquely identified so access activity can be attributed to an accountable person or controlled account.",
  "intent": "Confirm that user identities are unique, traceable, and reviewed before authentication or access evidence is used for control judgment.",
  "applicability_questions": [
    "Does the service allow multiple people, organizations, administrators, or evaluators to access shared systems?",
    "Can actions on important systems or personal information be attributed to a unique account?",
    "Are shared, dormant, or ambiguous accounts prohibited or explicitly controlled?"
  ],
  "observable_signals": [
    "unique user id",
    "email identity",
    "oauth identity",
    "organization membership",
    "admin account",
    "shared account",
    "service account",
    "audit actor",
    "identity mapping"
  ],
  "required_operating_practices": [
    "unique user identification policy ownership and review cycle",
    "shared account prohibition or exception approval",
    "identity mapping review for external identity providers",
    "audit actor traceability review",
    "periodic review of dormant or duplicate identities"
  ],
  "required_evidence": [
    "user identification policy or procedure",
    "identity provider or user table configuration record",
    "shared account exception register",
    "audit actor traceability sample",
    "periodic identity review record"
  ],
  "common_defects": [
    "authentication exists but user actions cannot be tied to a unique actor",
    "shared operational accounts are used without exception approval",
    "external identity provider mappings are not reviewed after changes",
    "dormant or duplicate identities remain active without review"
  ],
  "automation_potential": "partial",
  "human_review_required": true,
