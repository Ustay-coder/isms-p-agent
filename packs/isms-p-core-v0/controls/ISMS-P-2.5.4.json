{
  "schemaVersion": 1,
  "control_id": "ISMS-P-2.5.4",
  "title": "비밀번호 관리",
  "domain": "보호대책 요구사항",
  "category": "인증 및 권한관리",
  "requirement": "Password and credential authentication controls must be defined, configured, reviewed, and exception-managed where password-based authentication remains in use.",
  "intent": "Confirm that password-based authentication is governed by policy, implemented in configuration, and reviewed with exceptions tracked.",
  "applicability_questions": [
    "Does the service or an administrator path allow password-based login or fallback credentials?",
    "Are password requirements, reset flows, temporary passwords, or credential recovery paths present?",
    "Are password policy exceptions reviewed when SSO, OAuth, or MFA changes reduce direct password use?"
  ],
  "observable_signals": [
    "password policy",
    "password reset",
    "credential recovery",
    "temporary password",
    "minimum length",
    "lockout",
    "password history",
    "oauth fallback",
    "admin password"
  ],
  "required_operating_practices": [
    "password policy ownership and review cycle",
    "password configuration and recovery flow review",
    "temporary or fallback credential exception approval",
    "privileged password or break-glass credential review",
    "periodic password-control effectiveness review"
  ],
  "required_evidence": [
    "password management policy or procedure",
    "password and credential configuration export",
    "password reset or recovery flow review record",
    "temporary credential exception register",
    "periodic password-control review record"
  ],
  "common_defects": [
    "password controls are assumed unnecessary because OAuth or SSO exists but fallback paths remain",
    "temporary credentials are issued without expiry or approval evidence",
    "password reset flows are implemented but not reviewed as an authentication control",
    "administrator password or break-glass credentials are not separately reviewed"
  ],
  "automation_potential": "partial",
  "human_review_required": true,
