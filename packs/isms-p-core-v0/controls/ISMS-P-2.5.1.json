{
  "schemaVersion": 1,
  "control_id": "ISMS-P-2.5.1",
  "title": "사용자 계정 관리",
  "domain": "보호대책 요구사항",
  "category": "인증 및 권한관리",
  "requirement": "User accounts must be created, changed, disabled, and reviewed through controlled ownership, approval, and lifecycle procedures.",
  "intent": "Confirm that account lifecycle operations are owned, approved, traceable, and periodically reviewed before account or permission evidence is treated as operating evidence.",
  "applicability_questions": [
    "Does the service create user, administrator, organization member, evaluator, or machine accounts?",
    "Can account state or role changes affect access to important systems or personal information?",
    "Is there an owner who can confirm account issuance, change, suspension, and removal records?"
  ],
  "observable_signals": [
    "account creation",
    "account lifecycle",
    "user status",
    "organization member",
    "role assignment",
    "invitation",
    "deactivation",
    "account audit",
    "permission change"
  ],
  "required_operating_practices": [
    "account lifecycle policy ownership and review cycle",
    "account issuance, change, suspension, and removal approval",
    "privileged or organization account review",
    "account exception approval and follow-up",
    "periodic account inventory reconciliation"
  ],
  "required_evidence": [
    "user account management policy or procedure",
    "account issuance, change, suspension, and removal log",
    "account and permission configuration record",
    "periodic account review record",
    "account exception approval record"
  ],
  "common_defects": [
    "accounts exist in the system but lifecycle owners are not documented",
    "role or organization membership changes are not tied to approval records",
    "disabled or inactive accounts are not reviewed periodically",
    "machine or service accounts are excluded from account inventory"
  ],
  "automation_potential": "partial",
  "human_review_required": true,
